# All settings are optional; defaults suit local development. No secrets are required.
QR_DATA_ROOT=backend/data/store      # where ingested runs are stored
QR_STATIC_DIR=                       # path to frontend/dist to serve the SPA from FastAPI
QR_REFRESH_ENABLED=false             # true: ingest at startup and refresh periodically
QR_REFRESH_INTERVAL_S=3600
QR_INGEST_MAX_STEP=72                # IFS publishes tp to 360 h
QR_KEEP_RUNS=2
QR_ARRAY_CACHE_SIZE=48
QR_TILE_CACHE_SIZE=4096
QR_MAX_GRID_CELLS=250000
QR_CORS_ORIGINS=["http://localhost:5173"]   # only needed when the SPA is on another origin
QR_LOG_LEVEL=INFO
